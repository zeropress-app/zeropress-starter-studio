{
  "name": "zeropress-starter-studio",
  "version": "0.7.6",
  "description": "A static ZeroPress site published from Studio",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "zeropress-theme dev ./theme --data ./zeropress-preview-data.json --public-dir ./public",
    "build": "zeropress-build ./theme --data ./zeropress-preview-data.json --public-dir ./public --out ./dist --empty-out-dir",
    "postbuild": "npm run search:replace-with-pagefind",
    "search:replace-with-pagefind": "node scripts/replace-search-with-pagefind.mjs",
    "dist:prettify": "node scripts/prettify.mjs",
    "dist:minify": "node scripts/minify.mjs",
    "preview": "npm run build && wrangler dev --local",
    "deploy": "wrangler deploy",
    "deploy:dry-run": "npm run build && wrangler deploy --dry-run",
    "test": "node --test",
    "format:wrangler": "node scripts/format-wrangler.mjs",
    "format:wrangler:check": "node scripts/format-wrangler.mjs --check"
  },
  "dependencies": {
    "@zeropress/build": "^0.7.6",
    "@zeropress/theme": "^0.7.6"
  },
  "devDependencies": {
    "jsonc-parser": "3.3.1",
    "pagefind": "1.5.2",
    "wrangler": "4.146.0"
  }
}
